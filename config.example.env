# mailcow-behind-apache - configuration
# Copy to config.env (git-ignored) and adjust:  cp config.example.env config.env
# Copier en config.env (ignore par git) puis adapter.

# Public hostname of the mail server: MX target, webmail, SMTP/IMAP host. Must resolve to SERVER_IP.
# Nom public du serveur mail (cible MX, webmail, hote SMTP/IMAP). Doit pointer vers SERVER_IP.
MAIL_HOSTNAME=mail.example.com

# Public IPv4 of the server (its reverse DNS / PTR must be MAIL_HOSTNAME, set at your hosting provider)
# IPv4 publique du serveur (son PTR doit etre MAIL_HOSTNAME, a regler chez l'hebergeur)
SERVER_IP=203.0.113.10

# Timezone for mailcow (tz database name)
TIMEZONE=Europe/Paris

# Where mailcow is installed
MAILCOW_DIR=/opt/mailcow-dockerized

# Mailcow listens on loopback only; Apache keeps ports 80/443 and proxies to it.
# Mailcow n'ecoute qu'en local ; Apache garde 80/443 et lui transmet les requetes.
MAILCOW_HTTP_PORT=8080
MAILCOW_HTTPS_PORT=8443

# Docker subnet for mailcow (first three octets). Pick one that no other Docker network uses:
#   docker network inspect $(docker network ls -q) -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# Sous-reseau Docker de mailcow (3 premiers octets), libre sur la machine.
MAILCOW_IPV4_NETWORK=10.77.1

# IPv6: only enable if the server has working global IPv6 (and an AAAA + PTR for MAIL_HOSTNAME)
MAILCOW_ENABLE_IPV6=false

# Antivirus (ClamAV needs ~1.5-2.5 GB RAM). y = disable, n = enable
MAILCOW_SKIP_CLAMD=n

# Email for Let's Encrypt (certbot) notices
CERTBOT_EMAIL=admin@example.com

# Apply the memory/CPU limits from templates/docker-compose.override.yml (yes/no)
APPLY_RESOURCE_LIMITS=yes

# --- DNS publication (scripts/04-dns-publish.sh) ---
# Where the zones of your mail domains are hosted / Ou sont hebergees les zones DNS :
#   manual      any provider: prints a zone snippet to paste, reads current records through public DNS
#   gandi       Gandi LiveDNS (native API)              -> GANDI_PAT
#   cloudflare  Cloudflare (native API)                 -> CLOUDFLARE_API_TOKEN
#   lexicon     100+ providers through dns-lexicon      -> LEXICON_PROVIDER + its LEXICON_* credentials
#               (OVH, Route 53, GoDaddy, Namecheap, Infomaniak, DigitalOcean, Hetzner, Scaleway, ...)
# One provider per config.env; for domains spread over several providers, run 04-dns-publish.sh with
# --provider <name> (the credentials of each provider can all live in this file).
DNS_PROVIDER=manual

# Gandi: Personal Access Token with "Manage domain name technical configurations"
GANDI_PAT=

# Cloudflare: API token with Zone:Read and DNS:Edit on the zones
CLOUDFLARE_API_TOKEN=

# dns-lexicon (pipx install dns-lexicon): provider name and its credentials, named
# LEXICON_<PROVIDER>_<OPTION> (see `lexicon <provider> --help`). Examples:
#   LEXICON_PROVIDER=ovh
#   LEXICON_OVH_AUTH_ENTRYPOINT=ovh-eu
#   LEXICON_OVH_AUTH_APPLICATION_KEY=...
#   LEXICON_OVH_AUTH_APPLICATION_SECRET=...
#   LEXICON_OVH_AUTH_CONSUMER_KEY=...
LEXICON_PROVIDER=

# DMARC policy for new domains: none (monitor) -> quarantine -> reject once reports are clean
DMARC_POLICY=none
# Mailbox receiving DMARC aggregate reports; {domain} is replaced by each domain
DMARC_RUA=postmaster@{domain}

# Extra SPF mechanisms to keep for each domain (e.g. include:_spf.google.com for a SaaS that sends as you)
SPF_EXTRA=

# Root-only file where generated mailbox passwords are appended
CREDENTIALS_FILE=/root/mailcow-mailboxes.txt
